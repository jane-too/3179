{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#F7F4EE",
  "width": 1046,
  "height": 295,
  "padding": 5,
  "title": {
    "text": "DRAFT — Merchandise fills half the market, and groceries and eateries share the rest",
    "subtitle": [
      "DRAFT — Each panel is all 150 permanent stalls at South Melbourne Market in 2024-25, one square per stall, with one",
      "trade filled in. The five SO:ME Space stalls are left out because that space is a rotating pop-up rather than permanent",
      "trading space. Categories follow the market's own published scheme, in which services are counted with general merchandise."
    ],
    "anchor": "start",
    "font": "Fraunces",
    "fontSize": 20,
    "fontWeight": 600,
    "color": "#1A1A17",
    "subtitleFont": "Archivo",
    "subtitleFontSize": 13.5,
    "subtitleColor": "#6B675F",
    "subtitleLineHeight": 18,
    "offset": 34
  },
  "data": {
    "url": "data/stall_mix.csv",
    "format": {
      "type": "csv",
      "parse": {
        "stalls": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.market == 'South Melbourne Market'"
    },
    {
      "filter": "datum.category != 'SO:ME Space pop-up'"
    },
    {
      "calculate": "datum.category == 'General merchandise' || datum.category == 'Services' ? 'General merchandise & services' : datum.category",
      "as": "trade"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "stalls",
          "as": "stalls"
        }
      ],
      "groupby": [
        "trade"
      ]
    },
    {
      "calculate": "datum.trade == 'Grocery' ? 0 : datum.trade == 'Eateries' ? 1 : 2",
      "as": "panel"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "stalls",
          "as": "total"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "stalls",
          "as": "lo"
        }
      ]
    },
    {
      "calculate": "datum.stalls / datum.total * 100",
      "as": "share_pct"
    },
    {
      "calculate": "datum.panel * 17",
      "as": "panel_x"
    },
    {
      "calculate": "sequence(0, datum.total)",
      "as": "unit"
    },
    {
      "flatten": [
        "unit"
      ]
    },
    {
      "calculate": "datum.unit < datum.stalls",
      "as": "filled"
    },
    {
      "calculate": "datum.panel_x + datum.unit % 15",
      "as": "x"
    },
    {
      "calculate": "floor(datum.unit / 15)",
      "as": "y"
    }
  ],
  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "axis": null,
      "title": null,
      "scale": {
        "domain": [
          -0.5,
          48.5
        ]
      }
    },
    "y": {
      "field": "y",
      "type": "quantitative",
      "axis": null,
      "title": null,
      "scale": {
        "domain": [
          13.6,
          -0.5
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "square",
        "size": 289,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.filled",
            "value": "#2F6B45"
          },
          "value": "#DDDDDD"
        },
        "tooltip": [
          {
            "field": "trade",
            "type": "nominal",
            "title": "Trade"
          },
          {
            "field": "stalls",
            "type": "quantitative",
            "title": "Stalls"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of 150 stalls (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.unit == 0"
        },
        {
          "calculate": "datum.trade == 'Grocery' ? 'Groceries' : datum.trade",
          "as": "heading"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": -9,
        "dy": 22,
        "font": "Archivo",
        "fontSize": 16,
        "fontWeight": 600,
        "color": "#2E2A24"
      },
      "encoding": {
        "x": {
          "field": "panel_x",
          "type": "quantitative"
        },
        "y": {
          "datum": 9
        },
        "text": {
          "field": "heading",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.unit == 0"
        },
        {
          "calculate": "split(datum.trade == 'Grocery' ? 'Grocers run ' + datum.stalls + ' stalls,|' + format(datum.share_pct, '.0f') + '% of the market.' : datum.stalls == datum.lo ? datum.trade + ' are the smallest trade,|with ' + datum.stalls + ' stalls (' + format(datum.share_pct, '.0f') + '%).' : datum.stalls > datum.total - datum.stalls ? 'Its ' + datum.stalls + ' stalls (' + format(datum.share_pct, '.0f') + '%) outnumber the|other two trades combined.' : 'It holds ' + datum.stalls + ' stalls,|' + format(datum.share_pct, '.0f') + '% of the market.', '|')",
          "as": "line1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": -9,
        "dy": 47,
        "font": "Archivo",
        "fontSize": 14.5,
        "fontWeight": 400,
        "color": "#2E2A24",
        "lineHeight": 19
      },
      "encoding": {
        "x": {
          "field": "panel_x",
          "type": "quantitative"
        },
        "y": {
          "datum": 9
        },
        "text": {
          "field": "line1",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#F7F4EE"
  }
}
