{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#F7F4EE",
  "width": "container",
  "height": 440,
  "title": {
    "text": "DRAFT — The trade that fills the most stalls is the main draw for only 6% of visitors",
    "subtitle": [
      "DRAFT — Each trade's share of South Melbourne Market's 150 permanent stalls, against the share of visitors who name",
      "it as their main reason for coming. Stall counts are from the 2024-25 annual report; visitor shares are from the",
      "market's 2026-30 strategic plan."
    ],
    "anchor": "start",
    "font": "Fraunces",
    "fontSize": 20,
    "fontWeight": 600,
    "color": "#1A1A17",
    "subtitleFont": "Archivo",
    "subtitleFontSize": 13.5,
    "subtitleColor": "#6B675F",
    "subtitleLineHeight": 18,
    "offset": 34
  },
  "data": {
    "url": "data/smm_stalls_vs_reason.csv",
    "format": {
      "type": "csv",
      "parse": {
        "share_of_stalls_pct": "number",
        "main_reason_pct": "number"
      }
    }
  },
  "transform": [
    {
      "fold": [
        "share_of_stalls_pct",
        "main_reason_pct"
      ],
      "as": [
        "measure",
        "pct"
      ]
    },
    {
      "calculate": "datum.measure == 'share_of_stalls_pct' ? 0 : 1",
      "as": "xpos"
    },
    {
      "calculate": "datum.category == 'Grocery' ? 'Groceries' : datum.category",
      "as": "display"
    },
    {
      "calculate": "datum.category == 'Grocery'",
      "as": "is_figure"
    }
  ],
  "encoding": {
    "x": {
      "field": "xpos",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          -1.1,
          2.1
        ]
      }
    },
    "y": {
      "field": "pct",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          78
        ]
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "!datum.is_figure"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#A07C0A",
        "strokeWidth": 2.5,
        "strokeCap": "round"
      },
      "encoding": {
        "detail": {
          "field": "category"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_figure"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#A07C0A",
        "strokeWidth": 5,
        "strokeCap": "round"
      },
      "encoding": {
        "detail": {
          "field": "category"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_figure && datum.xpos == 1"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#A39C8E",
        "strokeWidth": 1,
        "x2Offset": -12,
        "y2Offset": 17.0
      },
      "encoding": {
        "x": {
          "datum": 1
        },
        "y": {
          "datum": 61
        },
        "x2": {
          "datum": 1.35
        },
        "y2": {
          "datum": 50
        }
      }
    },
    {
      "transform": [
        {
          "filter": "!datum.is_figure && datum.xpos == 1"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#A39C8E",
        "strokeWidth": 1,
        "x2Offset": -12,
        "y2Offset": 26.0
      },
      "encoding": {
        "x": {
          "datum": 1
        },
        "y": {
          "datum": 6
        },
        "x2": {
          "datum": 1.35
        },
        "y2": {
          "datum": 27
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "opacity": 1,
        "color": "#A07C0A"
      },
      "encoding": {
        "size": {
          "condition": {
            "test": "datum.is_figure",
            "value": 160
          },
          "value": 80
        },
        "tooltip": [
          {
            "field": "display",
            "title": "Trade"
          },
          {
            "field": "measure",
            "title": "Measure"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "title": "Share (%)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "xpos": 0,
            "pct": 76,
            "h": "Share of stalls"
          },
          {
            "xpos": 1,
            "pct": 76,
            "h": "Main reason for visiting"
          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "text",
        "font": "Archivo",
        "fontSize": 14,
        "fontWeight": 600,
        "color": "#2E2A24",
        "baseline": "middle"
      },
      "encoding": {
        "text": {
          "field": "h"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.xpos == 0"
        },
        {
          "calculate": "format(datum.pct, '.0f') + '%'",
          "as": "v"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -16,
        "font": "Archivo",
        "fontSize": 15,
        "fontWeight": {
          "expr": "datum.is_figure ? 600 : 400"
        },
        "color": "#2E2A24"
      },
      "encoding": {
        "text": {
          "field": "v"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.xpos == 1"
        },
        {
          "calculate": "format(datum.pct, '.0f') + '%'",
          "as": "v"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 16,
        "font": "Archivo",
        "fontSize": 15,
        "fontWeight": {
          "expr": "datum.is_figure ? 600 : 400"
        },
        "color": "#2E2A24"
      },
      "encoding": {
        "text": {
          "field": "v"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.xpos == 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -58,
        "font": "Archivo",
        "fontSize": 14,
        "color": "#2E2A24",
        "fontWeight": 400
      },
      "encoding": {
        "text": {
          "field": "display"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.xpos == 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 58,
        "font": "Archivo",
        "fontSize": 14,
        "color": "#2E2A24",
        "fontWeight": 400
      },
      "encoding": {
        "text": {
          "field": "display"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "note": 1
          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "font": "Archivo",
        "fontSize": 13.5,
        "color": "#6B675F",
        "text": "Eateries are not shown: no main-reason figure is published for them."
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 440
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_figure && datum.xpos == 1"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "#FCFBF8",
        "stroke": "#DFD9CC",
        "strokeWidth": 1,
        "cornerRadius": 2,
        "xOffset": -12,
        "x2Offset": 180,
        "yOffset": -8,
        "y2Offset": 42
      },
      "encoding": {
        "x": {
          "datum": 1.35
        },
        "x2": {
          "datum": 1.35
        },
        "y": {
          "datum": 50
        },
        "y2": {
          "datum": 50
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_figure && datum.xpos == 1"
        },
        {
          "calculate": "split('More than 3 visitors in 5|come mainly for groceries.', '|')",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "lineHeight": 18,
        "font": "Archivo",
        "fontSize": 13.5,
        "fontWeight": 300,
        "color": "#2E2A24"
      },
      "encoding": {
        "x": {
          "datum": 1.35
        },
        "y": {
          "datum": 50
        },
        "text": {
          "field": "note"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "!datum.is_figure && datum.xpos == 1"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "#FCFBF8",
        "stroke": "#DFD9CC",
        "strokeWidth": 1,
        "cornerRadius": 2,
        "xOffset": -12,
        "x2Offset": 180,
        "yOffset": -8,
        "y2Offset": 60
      },
      "encoding": {
        "x": {
          "datum": 1.35
        },
        "x2": {
          "datum": 1.35
        },
        "y": {
          "datum": 27
        },
        "y2": {
          "datum": 27
        }
      }
    },
    {
      "transform": [
        {
          "filter": "!datum.is_figure && datum.xpos == 1"
        },
        {
          "calculate": "split('It fills half the market’s stalls,|yet only ' + format(datum.pct, '.0f') + ' visitors in 100|come primarily for it.', '|')",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "lineHeight": 18,
        "font": "Archivo",
        "fontSize": 13.5,
        "fontWeight": 300,
        "color": "#2E2A24"
      },
      "encoding": {
        "x": {
          "datum": 1.35
        },
        "y": {
          "datum": 27
        },
        "text": {
          "field": "note"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#F7F4EE"
  }
}
