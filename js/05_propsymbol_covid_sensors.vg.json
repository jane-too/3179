    {
      "data": {
        "url": "data/sensors_covid_change_2020_vs_2019.csv",
        "format": {
          "type": "csv",
          "parse": {
            "counts_2019": "number",
            "counts_2020": "number",
            "pct_change": "number",
            "latitude": "number",
            "longitude": "number",
            "mappable": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.group == 'QVM area' ? datum.counts_2019 : 0",
          "as": "q19"
        },
        {
          "calculate": "datum.group == 'QVM area' ? datum.counts_2020 : 0",
          "as": "q20"
        },
        {
          "calculate": "datum.group != 'QVM area' ? datum.counts_2019 : 0",
          "as": "c19"
        },
        {
          "calculate": "datum.group != 'QVM area' ? datum.counts_2020 : 0",
          "as": "c20"
        },
        {
          "calculate": "datum.group == 'QVM area' ? 1 : 0",
          "as": "qn"
        },
        {
          "calculate": "datum.group != 'QVM area' ? 1 : 0",
          "as": "cn"
        },
        {
          "calculate": "datum.group == 'QVM area' && datum.mappable == 1 ? 1 : 0",
          "as": "qmap"
        },
        {
          "calculate": "datum.group != 'QVM area' && datum.mappable == 1 ? 1 : 0",
          "as": "cmap"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "q19",
              "as": "q19"
            },
            {
              "op": "sum",
              "field": "q20",
              "as": "q20"
            },
            {
              "op": "sum",
